# Cabeceras de seguridad y caché para Cloudflare Pages.
# Si modificás el <script> corto del <head> de index.html, el hash 'sha256-...' de abajo
# deja de coincidir. Mirá la sección "Si cambiás el script del head" del README.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-K9SA8ya5R9LcZpHTdosm7CwtzGpECNmz8DAcVBdBFDE=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Páginas HTML: siempre la versión más nueva
/
  Cache-Control: public, max-age=0, must-revalidate

# Estilos y JavaScript: 1 día (subí el ?v= en index.html para forzar la actualización)
/assets/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Imágenes y fuentes: 30 días
/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
